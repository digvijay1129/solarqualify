# Application environment
NODE_ENV=development
PORT=5000

# MongoDB connection
MONGODB_URI=mongodb://127.0.0.1:27017/solarqualify

# Authentication
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=1h

# Frontend origin
CLIENT_ORIGIN=http://127.0.0.1:5173

# File upload
MAX_UPLOAD_MB=5

# ImageKit private document storage
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Generate a fresh 32-byte key: openssl rand -base64 32
DOCUMENT_ENCRYPTION_KEY=