{
  "name": "solarqualify",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered rooftop solar lead qualification, quotation and project tracking platform",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace=@solarqualify/client",
    "build:client": "npm run build --workspace=@solarqualify/client",
    "preview:client": "npm run preview --workspace=@solarqualify/client",
    "dev:server": "npm run dev --workspace=@solarqualify/server",
    "start:server": "npm run start --workspace=@solarqualify/server",
    "test:client": "npm run test --workspace=@solarqualify/client",
    "test:server": "npm run test --workspace=@solarqualify/server"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.0",
    "morgan": "^1.12.1"
  }
}
